<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CafeMaestro.Controls"
             xmlns:vm="clr-namespace:CafeMaestro.ViewModels"
             x:Class="CafeMaestro.SettingsPage"
             x:DataType="vm:SettingsIndexPageViewModel"
             BackgroundColor="{DynamicResource SurfaceColor}"
             Shell.NavBarIsVisible="False"
             Title="Settings">

    <ContentPage.Resources>
        <!-- One row shape for every destination: name, current value, chevron. -->
        <Style x:Key="SettingsRowStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceMd}">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <Label Text="Settings"
                       FontFamily="{StaticResource FontFamilyEmphasis}"
                       FontSize="{StaticResource FontSizeHeadline}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center" />
                <controls:IconView Grid.Column="1"
                                   Data="{StaticResource IconSettingsData}"
                                   IconSize="{StaticResource IconSizeLg}"
                                   VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource SettingsRowStyle}"
                    SemanticProperties.Description="Roasting preferences"
                    SemanticProperties.Hint="{Binding RoastingSummary}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenRoastingCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label Text="Roasting" Style="{StaticResource CardTitleStyle}" />
                        <Label Text="{Binding RoastingSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <controls:IconView Grid.Column="1" Data="{StaticResource IconChevronData}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowStyle}"
                    SemanticProperties.Description="Appearance"
                    SemanticProperties.Hint="{Binding AppearanceSummary}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenAppearanceCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label Text="Appearance" Style="{StaticResource CardTitleStyle}" />
                        <Label Text="{Binding AppearanceSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <controls:IconView Grid.Column="1" Data="{StaticResource IconChevronData}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowStyle}"
                    SemanticProperties.Description="Data and backups"
                    SemanticProperties.Hint="{Binding DataSummary}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenDataCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label Text="Data &amp; Backups" Style="{StaticResource CardTitleStyle}" />
                        <Label Text="{Binding DataSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <controls:IconView Grid.Column="1" Data="{StaticResource IconChevronData}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowStyle}"
                    SemanticProperties.Description="Roast levels"
                    SemanticProperties.Hint="{Binding RoastLevelSummary}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenRoastLevelsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label Text="Roast Levels" Style="{StaticResource CardTitleStyle}" />
                        <Label Text="{Binding RoastLevelSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <controls:IconView Grid.Column="1" Data="{StaticResource IconChevronData}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowStyle}"
                    SemanticProperties.Description="About CafeMaestro"
                    SemanticProperties.Hint="{Binding AboutSummary}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenAboutCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label Text="About" Style="{StaticResource CardTitleStyle}" />
                        <Label Text="{Binding AboutSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <controls:IconView Grid.Column="1" Data="{StaticResource IconChevronData}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
