<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CafeMaestro.Controls"
             xmlns:local="clr-namespace:CafeMaestro"
             xmlns:settings="clr-namespace:CafeMaestro.Views.Settings"
             xmlns:vm="clr-namespace:CafeMaestro.ViewModels"
             x:Class="CafeMaestro.SettingsPage"
             x:Name="RootPage"
             x:DataType="vm:SettingsIndexPageViewModel"
             BackgroundColor="{DynamicResource SurfaceColor}"
             Shell.NavBarIsVisible="False"
             SizeChanged="OnPageSizeChanged"
             Title="Settings">

    <ContentPage.Resources>
        <!-- One row shape for every destination: name, current value, chevron. -->
        <Style x:Key="SettingsRowStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"
          Padding="{StaticResource PagePadding}"
          RowSpacing="{StaticResource SpaceMd}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <Label Text="Settings"
                   FontFamily="{StaticResource FontFamilyEmphasis}"
                   FontSize="{StaticResource FontSizeHeadline}"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   VerticalOptions="Center" />
            <controls:IconView Grid.Column="1"
                               Data="{StaticResource IconSettingsData}"
                               IconSize="{StaticResource IconSizeLg}"
                               InputTransparent="True"
                               VerticalOptions="Center" />
        </Grid>

        <!--
            Narrow: the rows are the whole page and each one navigates away.
            Wide: the rows become a rail and the chosen section opens beside them, so a tablet
            reaches any setting in the same single tap a phone does.
        -->
        <Grid x:Name="SettingsBody"
              Grid.Row="1"
              ColumnDefinitions="*,0"
              ColumnSpacing="{StaticResource SpaceLg}">
            <ScrollView Grid.Column="0">
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                    <Border Style="{StaticResource SettingsRowStyle}"
                            SemanticProperties.Description="Roasting preferences"
                            SemanticProperties.Hint="{Binding RoastingSummary}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsRoastingHighlighted}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource RoastColor}" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource RoastSurfaceColor}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenRoastingCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Roasting" Style="{StaticResource CardTitleStyle}" />
                                <Label Text="{Binding RoastingSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" VerticalOptions="Center">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenRoastingCommand}"
                                        SemanticProperties.Description="Open roasting preferences" />
                                <controls:IconView Data="{StaticResource IconChevronData}" InputTransparent="True"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}"
                            SemanticProperties.Description="Appearance"
                            SemanticProperties.Hint="{Binding AppearanceSummary}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsAppearanceHighlighted}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource RoastColor}" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource RoastSurfaceColor}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAppearanceCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Appearance" Style="{StaticResource CardTitleStyle}" />
                                <Label Text="{Binding AppearanceSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" VerticalOptions="Center">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenAppearanceCommand}"
                                        SemanticProperties.Description="Open appearance settings" />
                                <controls:IconView Data="{StaticResource IconChevronData}" InputTransparent="True"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}"
                            SemanticProperties.Description="Data and backups"
                            SemanticProperties.Hint="{Binding DataSummary}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDataHighlighted}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource RoastColor}" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource RoastSurfaceColor}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenDataCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Data &amp; Backups" Style="{StaticResource CardTitleStyle}" />
                                <Label Text="{Binding DataSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" VerticalOptions="Center">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenDataCommand}"
                                        SemanticProperties.Description="Open data and backup settings" />
                                <controls:IconView Data="{StaticResource IconChevronData}" InputTransparent="True"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}"
                            SemanticProperties.Description="Roast levels"
                            SemanticProperties.Hint="{Binding RoastLevelSummary}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsRoastLevelsHighlighted}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource RoastColor}" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource RoastSurfaceColor}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenRoastLevelsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Roast Levels" Style="{StaticResource CardTitleStyle}" />
                                <Label Text="{Binding RoastLevelSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" VerticalOptions="Center">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenRoastLevelsCommand}"
                                        SemanticProperties.Description="Open roast level settings" />
                                <controls:IconView Data="{StaticResource IconChevronData}" InputTransparent="True"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}"
                            SemanticProperties.Description="About CafeMaestro"
                            SemanticProperties.Hint="{Binding AboutSummary}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsAboutHighlighted}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource RoastColor}" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource RoastSurfaceColor}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAboutCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="About" Style="{StaticResource CardTitleStyle}" />
                                <Label Text="{Binding AboutSummary}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" VerticalOptions="Center">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenAboutCommand}"
                                        SemanticProperties.Description="Open About CafeMaestro" />
                                <controls:IconView Data="{StaticResource IconChevronData}" InputTransparent="True"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!--
                The wide pane carries the section's own editor, not a description of it. The
                host is filled from code-behind with the very ContentView that section's page
                uses, so every setting has exactly one implementation, and only the sections
                actually opened are ever built.
            -->
            <Border x:Name="WideDetailPane"
                    Grid.Column="1"
                    Style="{StaticResource RaisedCardStyle}"
                    Padding="0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="{StaticResource CardPadding}"
                          ColumnSpacing="{StaticResource SpaceMd}">
                        <Label Text="{Binding SelectedSectionTitle}"
                               Style="{StaticResource CardTitleStyle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="FULL SCREEN"
                                Style="{StaticResource QuietActionStyle}"
                                Command="{Binding OpenSelectedSectionCommand}"
                                MinimumHeightRequest="{StaticResource ControlHeightMin}"
                                SemanticProperties.Hint="Opens this section as its own page" />
                    </Grid>

                    <ContentView x:Name="SectionHost" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
