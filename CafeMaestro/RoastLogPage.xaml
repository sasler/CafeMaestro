<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CafeMaestro.Controls"
             xmlns:local="clr-namespace:CafeMaestro"
             xmlns:vm="clr-namespace:CafeMaestro.ViewModels"
             x:Class="CafeMaestro.RoastLogPage"
             x:DataType="vm:RoastLogPageViewModel"
             BackgroundColor="{DynamicResource SurfaceColor}"
             Shell.NavBarIsVisible="False"
             SizeChanged="OnPageSizeChanged"
             Title="Roast Log">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0"
                             Padding="{StaticResource PagePadding}"
                             Spacing="{StaticResource SpaceMd}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                <VerticalStackLayout>
                    <Label Text="Roast Log"
                           FontFamily="{StaticResource FontFamilyEmphasis}"
                           FontSize="{StaticResource FontSizeHeadline}"
                           TextColor="{DynamicResource PrimaryTextColor}" />
                    <Label Text="{Binding RecordCount, StringFormat='{0} batches'}"
                           Style="{StaticResource CardMetaStyle}" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="{StaticResource SpaceSm}">
                    <Grid>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding NavigateToImportCommand}"
                                SemanticProperties.Description="Import roast log CSV" />
                        <controls:IconView Data="{StaticResource IconImportData}"
                                           InputTransparent="True"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                    <Grid>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ExportLogCommand}"
                                SemanticProperties.Description="Export roast log CSV" />
                        <controls:IconView Data="{StaticResource IconExportData}"
                                           InputTransparent="True"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                    <Grid>
                        <Button Style="{StaticResource AccentIconButtonStyle}"
                                Command="{Binding AddRoastCommand}"
                                SemanticProperties.Description="Start a new roast" />
                        <controls:IconView Data="{StaticResource IconAddData}"
                                           IconColor="{DynamicResource OnRoastColor}"
                                           InputTransparent="True"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <Grid x:Name="LogBody"
              Grid.Row="1"
              ColumnDefinitions="*,0"
              ColumnSpacing="{StaticResource SpaceLg}"
              Margin="{StaticResource PagePadding}">
            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource SpaceLg}">
                <VerticalStackLayout Grid.Row="0" Spacing="{StaticResource SpaceLg}">
                    <SearchBar Placeholder="Search bean, notes, summary, or roast level"
                               Text="{Binding SearchText, Mode=TwoWay}"
                               SearchCommand="{Binding SearchCommand}"
                               BackgroundColor="{DynamicResource ElevatedSurfaceColor}"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               PlaceholderColor="{DynamicResource SecondaryTextColor}"
                               CancelButtonColor="{DynamicResource SecondaryTextColor}"
                               MinimumHeightRequest="{StaticResource ControlHeightMin}"
                               SemanticProperties.Description="Search roast log" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="{StaticResource SpaceSm}">
                            <Button Text="All" Style="{StaticResource SecondaryActionStyle}"
                                    Command="{Binding SelectFilterCommand}"
                                    CommandParameter="{x:Static vm:RoastLogFilter.All}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsAllSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource RoastSurfaceColor}" />
                                        <Setter Property="TextColor" Value="{DynamicResource RoastColor}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="Complete" Style="{StaticResource SecondaryActionStyle}"
                                    Command="{Binding SelectFilterCommand}"
                                    CommandParameter="{x:Static vm:RoastLogFilter.Complete}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsCompleteSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource RoastSurfaceColor}" />
                                        <Setter Property="TextColor" Value="{DynamicResource RoastColor}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="Needs weight" Style="{StaticResource SecondaryActionStyle}"
                                    Command="{Binding SelectFilterCommand}"
                                    CommandParameter="{x:Static vm:RoastLogFilter.NeedsWeight}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsNeedsWeightSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ReadySurfaceColor}" />
                                        <Setter Property="TextColor" Value="{DynamicResource ReadyColor}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="Unweighed" Style="{StaticResource SecondaryActionStyle}"
                                    Command="{Binding SelectFilterCommand}"
                                    CommandParameter="{x:Static vm:RoastLogFilter.Unweighed}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsUnweighedSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ElevatedSurfaceColor}" />
                                        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>
                    </ScrollView>
                    <Border Style="{StaticResource ErrorBannerStyle}" IsVisible="{Binding HasLoadError}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                            <Label Text="{Binding LoadErrorMessage}" Style="{StaticResource ErrorBannerTextStyle}" />
                            <Button Grid.Column="1" Text="Retry" Style="{StaticResource SecondaryActionStyle}"
                                    Command="{Binding RefreshCommand}" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding HasOpenWork}" Spacing="{StaticResource SpaceSm}">
                        <Label Text="OPEN WORK" Style="{StaticResource SectionHeaderStyle}" />
                        <ScrollView MaximumHeightRequest="420" VerticalScrollBarVisibility="Default">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OpenWork}"
                                                 Spacing="{StaticResource SpaceMd}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoastLogCard">
                                        <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                                            <controls:RoastStatusCard Card="{Binding .}">
                                                <controls:RoastStatusCard.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:RoastLogPage}}, Path=ViewModel.OpenDetailCommand, x:DataType=local:RoastLogPage}"
                                                        CommandParameter="{Binding .}" />
                                                </controls:RoastStatusCard.GestureRecognizers>
                                            </controls:RoastStatusCard>
                                            <Button Text="WEIGH IN"
                                                    Style="{StaticResource ConfirmActionStyle}"
                                                    IsVisible="{Binding CanWeigh}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:RoastLogPage}}, Path=ViewModel.WeighCommand, x:DataType=local:RoastLogPage}"
                                                    CommandParameter="{Binding .}"
                                                    SemanticProperties.Description="{Binding BeanDisplay, StringFormat='Weigh {0}'}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <RefreshView Grid.Row="1"
                             IsRefreshing="{Binding IsLoading}"
                             Command="{Binding RefreshCommand}">
                    <Grid>
                        <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource SpaceSm}" IsVisible="{Binding HasHistory}">
                            <Label Text="HISTORY" Style="{StaticResource SectionHeaderStyle}" />
                            <CollectionView Grid.Row="1" ItemsSource="{Binding History}" SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoastLogCard">
                                        <SwipeView>
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal">
                                                    <SwipeItem Text="Edit"
                                                               BackgroundColor="{DynamicResource RoastColor}"
                                                               Command="{Binding Source={RelativeSource AncestorType={x:Type local:RoastLogPage}}, Path=ViewModel.EditRoastCommand, x:DataType=local:RoastLogPage}"
                                                               CommandParameter="{Binding .}" />
                                                    <SwipeItem Text="Delete"
                                                               BackgroundColor="{DynamicResource DangerColor}"
                                                               Command="{Binding Source={RelativeSource AncestorType={x:Type local:RoastLogPage}}, Path=ViewModel.DeleteRoastCommand, x:DataType=local:RoastLogPage}"
                                                               CommandParameter="{Binding .}" />
                                                </SwipeItems>
                                            </SwipeView.RightItems>
                                            <controls:RoastStatusCard Card="{Binding .}">
                                                <controls:RoastStatusCard.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:RoastLogPage}}, Path=ViewModel.OpenDetailCommand, x:DataType=local:RoastLogPage}"
                                                        CommandParameter="{Binding .}" />
                                                </controls:RoastStatusCard.GestureRecognizers>
                                            </controls:RoastStatusCard>
                                        </SwipeView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>

                        <VerticalStackLayout Style="{StaticResource EmptyStateStyle}" IsVisible="{Binding IsEmpty}">
                            <Label Text="{Binding EmptyTitle}" Style="{StaticResource EmptyStateTitleStyle}" />
                            <Label Text="{Binding EmptyBody}" Style="{StaticResource EmptyStateBodyStyle}" />
                            <Button Text="CLEAR SEARCH AND FILTER" Style="{StaticResource SecondaryActionStyle}"
                                    IsVisible="{Binding CanClearEmptyState}"
                                    Command="{Binding ClearEmptyStateCommand}" />
                            <Button Text="START FIRST ROAST" Style="{StaticResource PrimaryActionStyle}"
                                    IsVisible="{Binding ShowStartEmptyState}"
                                    Command="{Binding AddRoastCommand}" />
                        </VerticalStackLayout>
                    </Grid>
                </RefreshView>
            </Grid>

            <Border x:Name="DetailPane"
                    Grid.Column="1"
                    Style="{StaticResource RaisedCardStyle}"
                    IsVisible="False">
                <!--
                    The placeholder is a sibling of the scroller, not its first child, so it
                    centres in the empty pane instead of hanging from the top of a tall tablet.
                -->
                <Grid>
                    <VerticalStackLayout Style="{StaticResource EmptyStateStyle}" IsVisible="{Binding HasNoSelectedCard}">
                        <Label Text="Select a roast" Style="{StaticResource EmptyStateTitleStyle}" />
                        <Label Text="Batch facts and result details appear here." Style="{StaticResource EmptyStateBodyStyle}" />
                    </VerticalStackLayout>
                    <ScrollView IsVisible="{Binding HasSelectedCard}">
                        <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                            <Label Text="ROAST DETAIL" Style="{StaticResource SectionHeaderStyle}" />
                            <controls:RoastStatusCard Card="{Binding SelectedCard}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceMd}">
                                <VerticalStackLayout>
                                    <Label Text="FIRST CRACK" Style="{StaticResource SectionHeaderStyle}" />
                                    <Label Text="{Binding SelectedCard.FirstCrackDisplay}" Style="{StaticResource NumericValueStyle}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="ROAST LEVEL" Style="{StaticResource SectionHeaderStyle}" />
                                    <Label Text="{Binding SelectedCard.LevelDisplay}" Style="{StaticResource NumericValueStyle}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="WEIGH IN" Style="{StaticResource ConfirmActionStyle}"
                                    IsVisible="{Binding SelectedCard.CanWeigh}"
                                    Command="{Binding WeighCommand}"
                                    CommandParameter="{Binding SelectedCard}" />
                            <Button Text="EDIT DETAILS" Style="{StaticResource SecondaryActionStyle}"
                                    IsVisible="{Binding CanEditSelected}"
                                    Command="{Binding EditRoastCommand}"
                                    CommandParameter="{Binding SelectedCard}" />
                            <Button Text="OPEN FULL DETAILS" Style="{StaticResource SecondaryActionStyle}"
                                    Command="{Binding OpenSelectedDetailCommand}" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
