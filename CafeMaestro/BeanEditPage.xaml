<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeMaestro.ViewModels"
             x:Class="CafeMaestro.BeanEditPage"
             x:DataType="vm:BeanEditPageViewModel"
             Title="{Binding PageTitle}"
             BackgroundColor="{DynamicResource SurfaceColor}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceLg}">
                <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                    <Label Text="{Binding PageHeading}"
                           FontFamily="{StaticResource FontFamilyEmphasis}"
                           FontSize="{StaticResource FontSizeHeadline}"
                           TextColor="{DynamicResource PrimaryTextColor}" />
                    <Label Text="Required identity fields come first. Inventory remains stored in kilograms."
                           Style="{StaticResource CardMetaStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Label Text="IDENTITY" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Coffee name *" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldContainerStyle}">
                                    <Entry Text="{Binding CoffeeName}" Placeholder="Guji, Huila, Nyeri…" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Country of origin *" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldContainerStyle}">
                                    <Entry Text="{Binding Country}" Placeholder="Ethiopia" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Label Text="DETAILS" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Variety" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldContainerStyle}">
                                    <Entry Text="{Binding Variety}" Placeholder="Heirloom, Bourbon…" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Process" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldContainerStyle}">
                                    <Picker SelectedItem="{Binding Process}" Title="Choose processing method" TextColor="{DynamicResource PrimaryTextColor}">
                                        <Picker.Items>
                                            <x:String>Washed</x:String><x:String>Natural</x:String><x:String>Honey</x:String>
                                            <x:String>Wet-hulled</x:String><x:String>Anaerobic</x:String><x:String>Carbonic Maceration</x:String><x:String>Other</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Purchase date" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldContainerStyle}">
                                    <DatePicker Date="{Binding PurchaseDate}" Format="d MMMM yyyy" TextColor="{DynamicResource PrimaryTextColor}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Store or website" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldContainerStyle}">
                                    <Entry Text="{Binding Link}" Placeholder="Optional URL" Keyboard="Url" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Label Text="INVENTORY" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Total quantity (kg) *" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldContainerStyle}">
                                    <Entry Text="{Binding Quantity}" Keyboard="Numeric" Placeholder="1.50" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Remaining quantity (kg) *" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldContainerStyle}">
                                    <Entry Text="{Binding RemainingQuantity}" Keyboard="Numeric" Placeholder="1.50" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="Price" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldContainerStyle}">
                                    <Entry Text="{Binding Price}" Keyboard="Numeric" Placeholder="Optional" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Label Text="NOTES" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource FieldContainerStyle}">
                        <Editor Text="{Binding Notes}"
                                Placeholder="Cupping notes, supplier details, or roast observations"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="120"
                                TextColor="{DynamicResource PrimaryTextColor}"
                                PlaceholderColor="{DynamicResource SecondaryTextColor}" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Style="{StaticResource ActionBarStyle}">
            <Button Text="SAVE BEAN" Style="{StaticResource ConfirmActionStyle}" Command="{Binding SaveCommand}" />
            <Button Text="CANCEL" Style="{StaticResource SecondaryActionStyle}" Command="{Binding CancelCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
