<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeMaestro.ViewModels"
             xmlns:roast="clr-namespace:CafeMaestro.Views.Roast"
             x:Class="CafeMaestro.RoastPage"
             x:DataType="vm:RoastPageViewModel"
             BackgroundColor="{DynamicResource SurfaceColor}"
             Shell.NavBarIsVisible="False"
             Title="Roast">
    <Grid>
        <roast:RoastSetupView IsVisible="{Binding IsSetupVisible}" />
        <roast:ActiveRoastView x:Name="ActiveView" IsVisible="{Binding IsActiveVisible}" />
        <roast:RoastHandoffView IsVisible="{Binding IsHandoffVisible}" />
        <roast:RoastRecoveryView IsVisible="{Binding IsRecoveryVisible}" />
        <roast:RoastPersistenceErrorView IsVisible="{Binding IsPersistenceErrorVisible}" />
    </Grid>
</ContentPage>
