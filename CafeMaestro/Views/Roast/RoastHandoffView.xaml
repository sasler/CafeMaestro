<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeMaestro.ViewModels"
             xmlns:models="clr-namespace:CafeMaestro.Models"
             xmlns:roast="clr-namespace:CafeMaestro.Views.Roast"
             x:Class="CafeMaestro.Views.Roast.RoastHandoffView"
             x:Name="Root"
             x:DataType="vm:RoastPageViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceLg}">
        <VerticalStackLayout>
            <Label Text="ROAST SESSION" Style="{StaticResource SectionHeaderStyle}" />
            <Label Text="Batch handoff" FontSize="{StaticResource FontSizeHeadline}" FontAttributes="Bold"
                   TextColor="{DynamicResource PrimaryTextColor}" />
            <Label Text="Cooling continues even after you finish this session." Style="{StaticResource CardMetaStyle}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Channels}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RoastChannelPresentation">
                    <Border Style="{StaticResource CoolingCardStyle}" Margin="0,0,0,12"
                            SemanticProperties.Description="{Binding SemanticDescription}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=ViewModel.WeighChannelCommand, x:DataType=roast:RoastHandoffView}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                            <roast:CoolingArcView Progress="{Binding CoolingProgress}" />
                            <Label Grid.Column="1" Text="{Binding BatchLabel}" Style="{StaticResource NumericValueStyle}" />
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="{Binding BeanDisplaySnapshot}" Style="{StaticResource CardTitleStyle}" />
                                <Label Text="{Binding StatusLabel}" Style="{StaticResource CardMetaStyle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="{StaticResource SpaceSm}">
                                <Button Text="{Binding TimeDisplay}"
                                        Command="{Binding Source={x:Reference Root}, Path=ViewModel.WeighChannelCommand, x:DataType=roast:RoastHandoffView}"
                                        CommandParameter="{Binding .}" IsEnabled="{Binding IsReady}"
                                        Style="{StaticResource SecondaryActionStyle}" MinimumHeightRequest="{StaticResource ControlHeightMin}"
                                        SemanticProperties.Description="{Binding SemanticDescription}"
                                        SemanticProperties.Hint="Opens final weight entry when this batch is ready" />
                                <Button Text="READY NOW"
                                        Command="{Binding Source={x:Reference Root}, Path=ViewModel.CompleteCoolingCommand, x:DataType=roast:RoastHandoffView}"
                                        CommandParameter="{Binding .}" IsVisible="{Binding CanCompleteCooling}"
                                        Style="{StaticResource QuietActionStyle}" MinimumHeightRequest="{StaticResource ControlHeightMin}"
                                        SemanticProperties.Description="{Binding CompleteCoolingSemanticDescription}"
                                        SemanticProperties.Hint="Ends this batch's cooling countdown after you confirm" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Style="{StaticResource ActionBarStyle}">
            <Button Text="{Binding PrimaryActionText}" Command="{Binding PrimaryHandoffActionCommand}"
                    Style="{StaticResource PrimaryActionStyle}" />
            <Button Text="{Binding SecondaryActionText}" Command="{Binding SecondaryHandoffActionCommand}"
                    Style="{StaticResource SecondaryActionStyle}" />
            <Button Text="ADJUST DROP TIME" Command="{Binding AdjustDropTimeCommand}"
                    Style="{StaticResource SecondaryActionStyle}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
