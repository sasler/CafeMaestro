<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:popupVm="clr-namespace:CafeMaestro.ViewModels.Popups"
             x:Class="CafeMaestro.Views.Popups.WeighInPopup"
             x:DataType="popupVm:WeighInViewModel"
             WidthRequest="340" Padding="{StaticResource SpaceMd}">
    <Border Style="{StaticResource ReadyCardStyle}">
        <VerticalStackLayout Spacing="{StaticResource SpaceLg}">
            <Label Text="{Binding ActionTitle}" Style="{StaticResource SectionHeaderStyle}" />
            <Label Text="{Binding Request.BeanDisplaySnapshot}" Style="{StaticResource CardTitleStyle}" />
            <Label Text="{Binding Request.BatchWeight, StringFormat='Batch {0:0.0} g in'}" Style="{StaticResource CardMetaStyle}" />
            <Border Style="{StaticResource FieldContainerStyle}">
                <Entry Text="{Binding FinalWeightText, Mode=TwoWay}" Keyboard="Numeric"
                       Placeholder="Final weight (g)" FontSize="{StaticResource FontSizeDisplay}"
                       Style="{StaticResource FieldEntryStyle}" SemanticProperties.Description="Final batch weight in grams" />
            </Border>
            <Label Text="{Binding LiveResult}" Style="{StaticResource NumericValueStyle}" />
            <Label Text="{Binding ValidationMessage}" Style="{StaticResource FieldErrorStyle}" />
            <Button Text="SAVE WEIGHT" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                    Style="{StaticResource ConfirmActionStyle}" />
            <Button Text="I NEVER WEIGHED THIS BATCH" Command="{Binding MarkUnweighedCommand}"
                    Style="{StaticResource SecondaryActionStyle}"
                    LineBreakMode="WordWrap"
                    IsVisible="{Binding CanMarkUnweighed}" />
            <Button Text="CANCEL" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryActionStyle}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
