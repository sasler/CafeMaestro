<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:popupVm="clr-namespace:CafeMaestro.ViewModels.Popups"
             x:Class="CafeMaestro.Views.Popups.ConfirmNavigationPopup"
             x:DataType="popupVm:ConfirmNavigationViewModel"
             WidthRequest="330" Padding="{StaticResource SpaceMd}">
    <Border Style="{StaticResource AttentionCardStyle}">
        <VerticalStackLayout Spacing="{StaticResource SpaceLg}">
            <Label Text="A ROAST IS ACTIVE" Style="{StaticResource SectionHeaderStyle}" />
            <Label Text="Keep roasting or explicitly discard this batch before leaving."
                   Style="{StaticResource CardMetaStyle}" />
            <Button Text="KEEP ROASTING" Command="{Binding KeepRoastingCommand}" Style="{StaticResource PrimaryActionStyle}" />
            <Button Text="DISCARD BATCH" Command="{Binding DiscardBatchCommand}" Style="{StaticResource DestructiveActionStyle}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
