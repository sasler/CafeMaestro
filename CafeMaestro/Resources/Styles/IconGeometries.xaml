    <x:String x:Key="IconChevronData">M9 5.4 L15.6 12 L9 18.6</x:String>
    <x:String x:Key="IconCloseData">M6.2 6.2 L17.8 17.8 M17.8 6.2 L6.2 17.8</x:String>

</ResourceDictionary>
