<!--
    Direction B icon language — Direction A's outline set.

    One 24 x 24 grid, 1.75 stroke, round caps and joins, no fills. Every glyph is a
    single-colour outline that takes its colour from the semantic palette, so light
    and dark are the same asset and a status icon can inherit its channel's colour.

    Two deliberate exceptions:
      * IconFirstCrackData is the only filled glyph - a hollow bolt loses its
        silhouette at 18 dp, and it is the one mark hunted for under time pressure.
      * IconSettingsData keeps the mechanical cog, redrawn hollow at 1.75.

    One hard rule: the circular arrow means Reset and nothing else. Starting the next
    batch is a bean with a plus badge (IconNewBatchData) because the circular arrow
    read as Reset. No other glyph in this file may use a circular arrow.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================== Roast domain ===================== -->

    <!-- Two overlapping beans remain unmistakable at tab-bar size. -->
    <x:String x:Key="IconBeanData">M4.4 7.2 C2.8 10.1 4.2 15.1 8 17.2 C11 18.8 13.8 16.5 13.6 12.8 C13.4 9.3 10.7 6.5 7.7 5.9 C6.3 5.6 5.1 6.1 4.4 7.2 Z M6.2 8.2 C7.8 9.1 8.6 11.1 8.2 13.1 C8 14.1 8.4 15 9.3 15.5 M11.2 6.2 C9.8 8.6 10.6 13.1 13.7 15.5 C16.4 17.6 19.4 16 20 12.8 C20.6 9.7 18.4 6.4 15.7 5.3 C13.9 4.6 12.1 4.9 11.2 6.2 Z M13.2 7.2 C14.6 8.4 15.4 10.1 15.2 11.8 C15 13 15.5 14 16.6 14.5</x:String>

    <!-- Roaster drum. -->
    <x:String x:Key="IconDrumData">M6 5.5 H16.5 A3.5 6.5 0 0 1 16.5 18.5 H6 M6 5.5 A3.5 6.5 0 1 0 6 18.5 A3.5 6.5 0 1 0 6 5.5 Z M16.5 9 H20 V15 H16.5 M4 20.5 H18.5</x:String>

    <!-- Stopwatch: the roast surface's own mark, and the Roast tab. -->
    <x:String x:Key="IconTimerData">M4.7 13.5 A7.3 7.3 0 1 1 19.3 13.5 A7.3 7.3 0 1 1 4.7 13.5 Z M12 10 V13.5 L14.4 14.9 M9.6 3 H14.4 M12 3 V5.2</x:String>

    <!-- First crack. The only filled glyph in the set; render with IsFilled="True". -->
    <x:String x:Key="IconFirstCrackData">M13.2 3.2 L7.6 12.6 H11.7 L10.6 20.8 L16.6 11.2 H12.4 Z</x:String>

    <!-- Drop: a drum mouth releases beans into a slotted cooling tray. -->
