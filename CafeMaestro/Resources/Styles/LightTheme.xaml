<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Direction B — Roast Console, light.

    The same semantic keys as DarkTheme.xaml, retuned for a bright kitchen counter:
    warm paper surfaces, ink text, and status hues darkened until they carry their
    own labels at AA on paper. Nothing here may be renamed independently of the dark
    dictionary - key parity is asserted by VisualSystemTests.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="CafeMaestro.LightTheme">

    <!-- ===================== Semantic surfaces ===================== -->
    <Color x:Key="SurfaceColor">#F7F5F2</Color>
    <Color x:Key="ElevatedSurfaceColor">#FFFDFB</Color>
    <Color x:Key="RaisedSurfaceColor">#F1E7DC</Color>
    <Color x:Key="SunkenSurfaceColor">#EDE9E3</Color>
    <Color x:Key="SkeletonColor">#EAE5DE</Color>

    <!-- ===================== Semantic text ===================== -->
    <Color x:Key="PrimaryTextColor">#1A1512</Color>
    <Color x:Key="SecondaryTextColor">#5F534B</Color>
    <Color x:Key="MutedTextColor">#74665D</Color>

    <!-- ===================== Lines ===================== -->
    <Color x:Key="BorderColor">#DED8D0</Color>
    <Color x:Key="SubtleBorderColor">#EAE5DE</Color>

    <!-- ===================== Status: roasting / action ===================== -->
    <Color x:Key="RoastColor">#A85600</Color>
    <Color x:Key="OnRoastColor">#FFF8F3</Color>
    <Color x:Key="RoastSurfaceColor">#FBEBDD</Color>
    <Color x:Key="RoastBorderColor">#D9B58F</Color>

    <!-- ===================== Status: cooling ===================== -->
    <Color x:Key="CoolingColor">#0E6E78</Color>
    <Color x:Key="OnCoolingColor">#F0FAFB</Color>
    <Color x:Key="CoolingSurfaceColor">#E3F1F3</Color>
    <Color x:Key="CoolingBorderColor">#B4DCE1</Color>

    <!-- ===================== Status: ready / complete ===================== -->
    <Color x:Key="ReadyColor">#1E7A46</Color>
    <Color x:Key="OnReadyColor">#F2FBF5</Color>
    <Color x:Key="ReadySurfaceColor">#E6F3EB</Color>
    <Color x:Key="ReadyBorderColor">#B7DCC5</Color>

    <!-- ===================== Status: attention ===================== -->
    <Color x:Key="AttentionColor">#765900</Color>
    <Color x:Key="OnAttentionColor">#FFFAF0</Color>
    <Color x:Key="AttentionSurfaceColor">#FBF1DA</Color>
    <Color x:Key="AttentionBorderColor">#E3CE9C</Color>

    <!-- ===================== Status: destructive / error ===================== -->
    <Color x:Key="DangerColor">#A5163F</Color>
    <Color x:Key="OnDangerColor">#FFF5F4</Color>
    <Color x:Key="DangerSurfaceColor">#FBE8EE</Color>
    <Color x:Key="DangerBorderColor">#E4B7C5</Color>

    <!-- ===================== Focus, disabled, scrim ===================== -->
    <Color x:Key="FocusColor">#1257C7</Color>
    <Color x:Key="DisabledColor">#9AA1A9</Color>
    <Color x:Key="DisabledSurfaceColor">#EFECE7</Color>
    <Color x:Key="ScrimColor">#661A1512</Color>
    <!-- A dark neutral status bar keeps Android 15 edge-to-edge icons contrast-safe. -->
    <Color x:Key="PlatformStatusBarColor">#1A1512</Color>
    <Color x:Key="PlatformNavigationBarColor">#FFFDFB</Color>

    <!-- ==================================================================
         Compatibility aliases - see DarkTheme.xaml for the rationale.
         ================================================================== -->
    <Color x:Key="PageBackgroundColor">#F7F5F2</Color>
    <Color x:Key="NavigationBarColor">#FFFDFB</Color>
    <Color x:Key="PrimaryColor">#A85600</Color>
    <Color x:Key="SecondaryColor">#0E6E78</Color>
    <Color x:Key="TertiaryColor">#1E7A46</Color>
    <Color x:Key="NeutralColor">#FFFDFB</Color>
    <Color x:Key="AccentColor">#A85600</Color>

    <Color x:Key="TextColor">#1A1512</Color>
    <Color x:Key="TertiaryTextColor">#74665D</Color>
    <Color x:Key="PlaceholderColor">#74665D</Color>
    <Color x:Key="InverseTextColor">#FFF8F3</Color>
    <Color x:Key="ButtonTextColor">#FFF8F3</Color>
    <Color x:Key="CardBackgroundColor">#FFFDFB</Color>
    <Color x:Key="ItemTimestampTextColor">#74665D</Color>
    <Color x:Key="ItemDetailTextColor">#5F534B</Color>
    <Color x:Key="TimerInstructionColor">#5F534B</Color>

    <Color x:Key="EntryBackgroundColor">#FFFFFF</Color>
    <Color x:Key="EntryBorderColor">#DED8D0</Color>
    <Color x:Key="PickerBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PickerBorderColor">#DED8D0</Color>

    <Color x:Key="SeparatorColor">#EAE5DE</Color>
    <Color x:Key="TimerBorderColor">#A85600</Color>

    <Color x:Key="SwipeEditColor">#0E6E78</Color>
    <Color x:Key="SwipeDeleteColor">#A5163F</Color>

    <Color x:Key="TransparentColor">Transparent</Color>
    <Color x:Key="CardShadowColor">#1A1A1512</Color>
    <Color x:Key="ItemCardHoverBackgroundColor">#F1ECE5</Color>
    <Color x:Key="TimerRunningIndicatorColor">#A85600</Color>
    <Color x:Key="PreviousRoastBackgroundColor">#FFFDFB</Color>
    <Color x:Key="PreviousRoastBorderColor">#DED8D0</Color>
    <Color x:Key="ErrorColor">#A5163F</Color>
    <Color x:Key="SuccessColor">#1E7A46</Color>
    <Color x:Key="HighlightColor">#FBF1DA</Color>
    <Color x:Key="ModalOverlayColor">#661A1512</Color>

</ResourceDictionary>
