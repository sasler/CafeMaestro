<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layouts="clr-namespace:CafeMaestro.Layouts"
             xmlns:controls="clr-namespace:CafeMaestro.Controls"
             xmlns:local="clr-namespace:CafeMaestro"
             xmlns:models="clr-namespace:CafeMaestro.Models"
             xmlns:vm="clr-namespace:CafeMaestro.ViewModels"
             x:Class="CafeMaestro.BeanInventoryPage"
             x:DataType="vm:BeanInventoryPageViewModel"
             BackgroundColor="{DynamicResource SurfaceColor}"
             Shell.NavBarIsVisible="False"
             Title="Beans"
             SizeChanged="OnPageSizeChanged">

    <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceMd}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
            <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource SpaceXs}" VerticalOptions="Center">
                <Label Text="Beans"
                       FontFamily="{StaticResource FontFamilyEmphasis}"
                       FontSize="{StaticResource FontSizeHeadline}"
                       TextColor="{DynamicResource PrimaryTextColor}" />
                <Label Text="{Binding InventorySummary}" Style="{StaticResource CardMetaStyle}" />
            </VerticalStackLayout>

            <Grid Grid.Column="1">
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{Binding SearchCommand}"
                        SemanticProperties.Description="Search beans" />
                <controls:IconView Data="{StaticResource IconSearchData}" InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Column="2">
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{Binding NavigateToImportCommand}"
                        SemanticProperties.Description="Import beans from CSV" />
                <controls:IconView Data="{StaticResource IconImportData}" InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Column="3">
                <Button Style="{StaticResource AccentIconButtonStyle}"
                        Command="{Binding AddBeanCommand}"
                        SemanticProperties.Description="Add bean" />
                <controls:IconView Data="{StaticResource IconAddData}"
                                   IconColor="{DynamicResource OnRoastColor}"
                                   InputTransparent="True"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ErrorBannerStyle}" IsVisible="{Binding HasLoadError}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <Label Text="{Binding LoadErrorMessage}" Style="{StaticResource ErrorBannerTextStyle}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Retry" Style="{StaticResource SecondaryActionStyle}" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <Grid x:Name="InventoryBody" Grid.Row="2" ColumnDefinitions="*,0" ColumnSpacing="{StaticResource SpaceLg}">
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource SpaceMd}">
                <!-- Search and filters act on the list, so on a tablet they sit above it, not across the page. -->
                <VerticalStackLayout Grid.Row="0" Spacing="{StaticResource SpaceMd}">
                    <SearchBar Placeholder="Search name, origin, variety, process, or notes"
                               Text="{Binding SearchText, Mode=TwoWay}"
                               SearchCommand="{Binding SearchCommand}"
                               BackgroundColor="{DynamicResource ElevatedSurfaceColor}"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               PlaceholderColor="{DynamicResource SecondaryTextColor}"
                               CancelButtonColor="{DynamicResource SecondaryTextColor}"
                               MinimumHeightRequest="{StaticResource ControlHeightMin}" />

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="{StaticResource SpaceSm}">
                            <Button Text="All" Style="{StaticResource SecondaryActionStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static vm:BeanInventoryFilter.All}" />
                            <Button Text="Available" Style="{StaticResource SecondaryActionStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static vm:BeanInventoryFilter.Available}" />
                            <Button Text="Low" Style="{StaticResource SecondaryActionStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static vm:BeanInventoryFilter.Low}" />
                            <Button Text="Out of stock" Style="{StaticResource SecondaryActionStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static vm:BeanInventoryFilter.OutOfStock}" />
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <Label Text="INVENTORY" Style="{StaticResource SectionHeaderStyle}" />
                    <Label Grid.Column="1" Text="{Binding FilterSummary}" Style="{StaticResource CardCaptionStyle}" />
                </Grid>

                <RefreshView Grid.Row="2" IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}">
                    <CollectionView ItemsSource="{Binding Beans}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:BeanData">
                                <SwipeView>
                                    <SwipeView.LeftItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem Text="Edit"
                                                       BackgroundColor="{DynamicResource ElevatedSurfaceColor}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type local:BeanInventoryPage}}, Path=ViewModel.EditBeanCommand, x:DataType=local:BeanInventoryPage}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.LeftItems>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem Text="Delete"
                                                       BackgroundColor="{DynamicResource DangerColor}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type local:BeanInventoryPage}}, Path=ViewModel.DeleteBeanCommand, x:DataType=local:BeanInventoryPage}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border Style="{StaticResource CardStyle}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:BeanInventoryPage}}, Path=ViewModel.OpenBeanCommand, x:DataType=local:BeanInventoryPage}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                                            <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource SpaceXs}">
                                                <Label Text="{Binding CoffeeName}" Style="{StaticResource CardTitleStyle}" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding Country}" Style="{StaticResource CardMetaStyle}" />
                                                <Label Text="{Binding DetailMetadataDisplay}" Style="{StaticResource CardCaptionStyle}" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpaceXs}" HorizontalOptions="End">
                                                <Label Text="{Binding RemainingQuantityDisplay}" Style="{StaticResource NumericValueStyle}" HorizontalTextAlignment="End" />
                                                <Border Style="{StaticResource AttentionChipStyle}" IsVisible="{Binding IsLowStock}" HorizontalOptions="End">
                                                    <Label Text="Low" Style="{StaticResource AttentionChipLabelStyle}" />
                                                </Border>
                                                <Border Style="{StaticResource StatusChipStyle}" IsVisible="{Binding IsOutOfStock}" HorizontalOptions="End">
                                                    <Label Text="Out" Style="{StaticResource StatusChipLabelStyle}" />
                                                </Border>
                                            </VerticalStackLayout>
                                            <Grid Grid.Column="2" VerticalOptions="Center">
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:BeanInventoryPage}}, Path=ViewModel.ShowBeanActionsCommand, x:DataType=local:BeanInventoryPage}"
                                                        CommandParameter="{Binding .}"
                                                        SemanticProperties.Description="Bean actions" />
                                                <controls:IconView Data="{StaticResource IconMoreData}" InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <VerticalStackLayout Grid.Row="2" Style="{StaticResource EmptyStateStyle}" IsVisible="{Binding IsEmptyInventory}">
                    <Label Text="No beans yet" Style="{StaticResource EmptyStateTitleStyle}" />
                    <Label Text="Add your first green coffee to begin tracking inventory." Style="{StaticResource EmptyStateBodyStyle}" />
                    <Button Text="ADD YOUR FIRST BEAN" Style="{StaticResource PrimaryActionStyle}" Command="{Binding AddBeanCommand}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Style="{StaticResource EmptyStateStyle}" IsVisible="{Binding IsSearchNoResults}">
                    <Label Text="No beans match your search" Style="{StaticResource EmptyStateTitleStyle}" />
                    <Label Text="Try another name, origin, variety, process, or note." Style="{StaticResource EmptyStateBodyStyle}" />
                    <Button Text="CLEAR SEARCH" Style="{StaticResource SecondaryActionStyle}" Command="{Binding ClearSearchCommand}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Style="{StaticResource EmptyStateStyle}" IsVisible="{Binding IsFilterNoResults}">
                    <Label Text="No beans in this state" Style="{StaticResource EmptyStateTitleStyle}" />
                    <Label Text="Choose All to return to the full inventory." Style="{StaticResource EmptyStateBodyStyle}" />
                    <Button Text="SHOW ALL" Style="{StaticResource SecondaryActionStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static vm:BeanInventoryFilter.All}" />
                </VerticalStackLayout>
            </Grid>

            <Border x:Name="DetailPane" Grid.Column="1" Style="{StaticResource RaisedCardStyle}" IsVisible="False">
                <!--
                    The placeholder is a sibling of the scroller, not its first child, so it
                    centres in the empty pane instead of hanging from the top of a tall tablet.
                -->
                <Grid>
                    <VerticalStackLayout Style="{StaticResource EmptyStateStyle}" IsVisible="{Binding HasNoSelectedBean}">
                        <Label Text="Select a bean" Style="{StaticResource EmptyStateTitleStyle}" />
                        <Label Text="Inventory facts and recent roast results appear here." Style="{StaticResource EmptyStateBodyStyle}" />
                    </VerticalStackLayout>
                    <ScrollView IsVisible="{Binding HasSelectedBean}">
                        <VerticalStackLayout Spacing="{StaticResource SpaceMd}"
                                             layouts:ResponsiveLayout.MaxContentWidth="{StaticResource ReadableContentWidth}">
                            <Label Text="{Binding SelectedBean.CoffeeName}" Style="{StaticResource CardTitleStyle}" FontSize="{StaticResource FontSizeHeadline}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding SelectedBean.Country}" Style="{StaticResource CardMetaStyle}" />
                            <Label Text="{Binding SelectedBean.DetailMetadataDisplay}" Style="{StaticResource CardCaptionStyle}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding SelectedBean.RemainingQuantityDisplay}" Style="{StaticResource NumericValueStyle}" />
                            <Label Text="LATEST COMPLETE ROAST" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}" IsVisible="{Binding HasSelectedLatestCompletedRoast}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding SelectedLatestCompletedRoast.ResultHeadline}" Style="{StaticResource CardTitleStyle}" />
                                    <Label Text="{Binding SelectedLatestCompletedRoast.ResultMetrics}" Style="{StaticResource CardMetaStyle}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                            <VerticalStackLayout IsVisible="{Binding HasSelectedRecentIncompleteRoasts}" Spacing="{StaticResource SpaceSm}">
                                <Label Text="RECENT INCOMPLETE WORK" Style="{StaticResource SectionHeaderStyle}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedRecentIncompleteRoasts}"
                                                     Spacing="{StaticResource SpaceSm}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:RoastData">
                                            <Border Style="{StaticResource CardStyle}"
                                                    SemanticProperties.Description="{Binding ResultHeadline}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                                                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                                        <Label Text="{Binding ResultHeadline}"
                                                               Style="{StaticResource CardTitleStyle}"
                                                               LineBreakMode="WordWrap" />
                                                        <Label Text="{Binding ResultMetrics}"
                                                               Style="{StaticResource CardMetaStyle}"
                                                               LineBreakMode="WordWrap" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding RoastDate, StringFormat='{0:d MMM}'}"
                                                           Style="{StaticResource CardCaptionStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <Button Text="START ROAST" Style="{StaticResource PrimaryActionStyle}" Command="{Binding StartSelectedRoastCommand}" />
                            <Button Text="OPEN FULL DETAILS" Style="{StaticResource SecondaryActionStyle}" Command="{Binding OpenSelectedDetailCommand}" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
